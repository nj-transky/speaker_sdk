prefix=/home/hyh/workspace/transky/project/mavsdk_mav_ftp_pro_prebuilt/prebuilt/linux/x86/third_party
exec_prefix=${prefix}
symbol_prefix=
libdir=${exec_prefix}/lib
sharedlibdir=${libdir}
includedir=${prefix}/include

Name: zlib
Description: zlib-ng compression library
Version: 1.3.0.zlib-ng

Requires:
Libs: -L${libdir} -L${sharedlibdir} -lz
Cflags: -I${includedir} -DWITH_GZFILEOP
